# LLM providers
GEMINI_API_KEY=
OPENAI_API_KEY=

# Application database connections (local development uses the host port 5433)
DATABASE_URL_ADMIN=postgresql://<user>:<password>@localhost:5433/<database>
DATABASE_URL_AGENT=postgresql://agent_reader:<password>@localhost:5433/<database>
DATABASE_URL_HISTORY=postgresql://history_writer:<password>@localhost:5433/<database>

# Postgres container: admin user, database and the passwords of the restricted roles
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
AGENT_DB_PASSWORD=
HISTORY_DB_PASSWORD=

# Langfuse observability (optional: leave empty to disable tracing)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# Logging level: INFO shows one line per turn with stage timings and cost, DEBUG adds each tool call
LOG_LEVEL=INFO